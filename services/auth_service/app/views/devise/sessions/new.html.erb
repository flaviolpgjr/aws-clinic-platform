<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-md">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-gray-900">
        Clinic Platform
      </h1>

      <p class="mt-2 text-sm text-gray-600">
        Gestão simples para sua clínica
      </p>
    </div>

    <div class="rounded-xl bg-white p-8 shadow-sm ring-1 ring-gray-200">
      <h2 class="mb-6 text-xl font-semibold text-gray-900">
        Entrar
      </h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="mb-4">
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700" %>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500" %>
        </div>

        <div class="mb-6">
          <%= f.label :password, "Senha", class: "block text-sm font-medium text-gray-700" %>

          <%= f.password_field :password,
                autocomplete: "current-password",
                class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500" %>
        </div>

        <%= f.submit "Entrar",
              class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-700" %>

      <% end %>

      <p class="mt-6 text-center text-sm text-gray-600">
        Ainda não possui conta?

        <%= link_to "Criar conta",
              new_registration_path(resource_name),
              class: "font-medium text-blue-600 hover:underline" %>
      </p>
    </div>
  </div>
</div>